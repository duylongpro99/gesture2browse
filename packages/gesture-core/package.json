{
  "name": "@gesture/gesture-core",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.json --emitDeclarationOnly --outDir dist --rootDir src",
    "test": "vitest run --passWithNoTests",
    "lint": "biome lint ./src",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.5.4",
    "xstate": "^5.32.6",
    "@gesture/protocol": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "vitest": "^5.0.0",
    "typescript": "^7.0.2"
  }
}
