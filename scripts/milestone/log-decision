#!/usr/bin/env bash
# Log a merged milestone's drafted §8 decision and retire its STATUS row, as one
# `[docs]` commit on the base branch (driving-a-milestone post-finish, ticket 0001).
#
# Roadmap §8 and STATUS-row removal are owner writes (CLAUDE.md §0). The driver
# runs this only after the owner's explicit approval, recorded in driver.json;
# without --apply it is a dry run that prints exactly what --apply would change.
#
# What it does:
#   1. refuses unless <M> is merged into the current branch (scripts/milestone/next STATE),
#      and the two files are clean in git;
#   2. takes the `| date | decision | input | result |` row from the "Proposed
#      decision(s) for roadmap §8" block under the plan's ## Status (worktree copy
#      first, else the root's); refuses when the block holds no table row;
#   3. inserts it after the last dated §8 row; removes every pending §8 row whose
#      Input cell's gates (G<n>) are all named by the new row's Input cell
#      (REPLACE); keeps the others (KEEP, with what they still need);
#   4. removes the <M> row from docs/STATUS.md;
#   5. with --apply: writes, commits (unless --no-commit), sets driver.json step=logged.
#
# Usage: scripts/milestone/log-decision <MILESTONE-ID> [--apply] [--no-commit]
# Exit: 0 printed/applied; 2 usage; 3 no files; 4 dirty; 5 not merged; 6 no §8 row in the plan;
#       7 the row is already in §8.
set -euo pipefail
[ $# -ge 1 ] || { echo "usage: log-decision <MILESTONE-ID> [--apply] [--no-commit]" >&2; exit 2; }
m=$1; shift; apply=0; commit=1
for a in "$@"; do case "$a" in --apply) apply=1 ;; --no-commit) commit=0 ;; *) echo "unknown flag $a" >&2; exit 2 ;; esac; done
here=$(cd "$(dirname "$0")" && pwd)
root=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
cd "$root"
roadmap=docs/05-roadmap.md; status_md=docs/STATUS.md
[ -f "$roadmap" ] && [ -f "$status_md" ] || { echo "no $roadmap or $status_md under $root" >&2; exit 3; }
base=$(git rev-parse --abbrev-ref HEAD)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/log-decision.XXXXXX"); trap 'rm -rf "$tmp"' EXIT

printf '===== log-decision %s  (%s @ %s; %s)\n' "$m" "$root" "$base" "$([ $apply = 1 ] && echo APPLY || echo dry-run)"

# ---- 1. merged? clean? ----
state=$("$here/next" "$m" | sed -n 's/^STATE: //p')
case "$state" in
  "$m merged"*) echo "STATE: $state" ;;
  *) echo "REFUSED: $state"; exit 5 ;;
esac
if [ -n "$(git status --porcelain --untracked-files=no -- "$roadmap" "$status_md")" ]; then
  echo "REFUSED: $roadmap or $status_md has uncommitted changes"; exit 4
fi

# ---- 2. the drafted row ----
slug=$(grep -E "^\| \*{0,2}${m}[ *|]" "$status_md" | sed -n 's|.*docs/plans/\([A-Za-z0-9._-]*\)\.md.*|\1|p' || true); [ -n "$slug" ] || slug=$m
plan=""
for d in "$root/.worktrees/$m" "$root"; do
  [ -d "$d" ] || continue
  [ -f "$d/docs/plans/$slug.md" ] && { plan="$d/docs/plans/$slug.md"; break; }
  for f in "$d"/docs/plans/"$m"*.md; do
    [ -f "$f" ] || continue
    case "$f" in *.spec.md|*.impl.md) ;; *) plan=$f; break 2 ;; esac
  done
done
[ -n "$plan" ] || { echo "REFUSED: no docs/plans/$slug.md (or docs/plans/$m*.md) in the worktree or the root"; exit 6; }
awk '/^## Status/{s=1} s && /^\*\*Proposed decisions? for roadmap §8/{p=1} p && /^[ \t]*$/ && n {exit} p {print; n++}' "$plan" > "$tmp/block"
row=$(grep -E '^(> *)?\|([^|]*\|){4,}' "$tmp/block" | head -1 | sed -E 's/^> *//' || true)
[ -n "$row" ] || { echo "REFUSED: no §8 table row in the Proposed-decision block of $plan (the owner writes the row by hand)"; exit 6; }
cellof() { printf '%s' "$row" | awk -F'|' -v i="$1" '{ c = $(i + 1); gsub(/^[ \t]+|[ \t]+$/, "", c); print c }'; }
r_date=$(cellof 1); r_input=$(cellof 3)
printf '%s' "$r_date" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' || { r_date=$(date +%F); row=$(printf '%s' "$row" | sed -E "s/^\|[^|]*\|/| $r_date |/"); }
echo "PLAN: $plan"
if grep -Fq -- "$row" "$roadmap"; then echo "REFUSED: this row is already in §8 of $roadmap (logged earlier)"; exit 7; fi
echo "INSERT: $row"
gates_of() { printf '%s' "$1" | grep -oE '(^|[^A-Za-z0-9])G[0-9]+' | sed -E 's/^[^G]//' | sort -u | tr '\n' ' ' || true; }
new_gates=$(gates_of "$r_input")

# ---- 3. §8 edit plan ----
# §8 table rows: line number, first cell, Input cell, Result cell
awk -F'|' '/^## 8\./{p=1; next} /^## /{p=0} p && /^\|/ && NF >= 5 {
  for (i = 2; i <= 5; i++) gsub(/^[ \t]+|[ \t]+$/, "", $i); printf "%d\t%s\t%s\t%s\n", NR, $2, $4, $5 }' "$roadmap" > "$tmp/s8"
last_dated=$(awk -F'\t' '$2 ~ /^[0-9]{4}-/ { n = $1 } END { print n + 0 }' "$tmp/s8")
[ "$last_dated" -gt 0 ] || last_dated=$(awk -F'\t' '$2 ~ /^-+$/ { print $1; exit }' "$tmp/s8")
[ "${last_dated:-0}" -gt 0 ] || { echo "REFUSED: no §8 table found in $roadmap"; exit 6; }
: > "$tmp/drop"
while IFS=$'\t' read -r ln first input result; do
  printf '%s' "$result" | grep -Eiq '^pending' || continue
  pg=$(gates_of "$input"); [ -n "$pg" ] || continue
  missing=""
  for g in $pg; do case " $new_gates " in *" $g "*) ;; *) missing="$missing$g ";; esac; done
  if [ -z "$missing" ]; then
    echo "$ln" >> "$tmp/drop"; echo "REPLACE: pending row (line $ln) | $(awk -F'|' -v n="$ln" 'NR == n { print $3 }' "$roadmap" | sed -E 's/^ +| +$//g') | $input |"
  elif [ "$missing" != "$pg " ]; then
    echo "KEEP: pending row (line $ln) | $(awk -F'|' -v n="$ln" 'NR == n { print $3 }' "$roadmap" | sed -E 's/^ +| +$//g') | $input | still needs: $missing"
  fi
done < "$tmp/s8"
[ -s "$tmp/drop" ] || echo "REPLACE: none (no pending §8 row is fully covered by: ${new_gates:-no gates in the Input cell})"

# ---- 4. STATUS row ----
status_ln=$(grep -nE "^\| \*{0,2}${m}[ *|]" "$status_md" | cut -d: -f1 | head -1 || true)
[ -n "$status_ln" ] && echo "STATUS-ROW: remove line $status_ln" || echo "STATUS-ROW: already absent"

# ---- build the new files ----
awk -v ins="$last_dated" -v row="$row" -v drops="$(tr '\n' ' ' < "$tmp/drop")" '
  BEGIN { split(drops, d, " "); for (i in d) if (d[i] != "") skip[d[i]] = 1 }
  skip[NR] { next } { print } NR == ins { print row }' "$roadmap" > "$tmp/roadmap"
if [ -n "$status_ln" ]; then awk -v n="$status_ln" 'NR != n' "$status_md" > "$tmp/status"; else cp "$status_md" "$tmp/status"; fi
echo "DIFF:"
diff -u "$roadmap" "$tmp/roadmap" | sed '1,2d' | cut -c1-200 || true
diff -u "$status_md" "$tmp/status" | sed '1,2d' | cut -c1-200 || true

[ $apply = 1 ] || { echo "summary: dry-run; nothing written. Re-run with --apply after the owner approves."; exit 0; }

# ---- 5. apply ----
cp "$tmp/roadmap" "$roadmap"; cp "$tmp/status" "$status_md"
git add "$roadmap" "$status_md"
if [ $commit = 1 ]; then
  git commit -q -m "[docs] roadmap §8: log $m decision; remove STATUS row" \
    -m "Owner-approved through driving-a-milestone log-decision (docs/tickets/0001)." \
    -m "Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>"
  echo "COMMIT: $(git rev-parse --short HEAD) on $base"
else
  echo "STAGED: $roadmap $status_md (no commit: --no-commit)"
fi
[ -f "$root/.worktrees/$m/docs/sdd/$m/driver.json" ] && "$here/driver-state" "$m" set step logged >/dev/null 2>&1 || true
echo "summary: §8 row logged for $m; STATUS row ${status_ln:+removed}${status_ln:-already absent}"
