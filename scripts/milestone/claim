#!/usr/bin/env bash
# Claim a milestone for the driving-a-milestone skill: set its docs/STATUS.md
# "Owner session" cell to drv-<M> on the base branch, commit, and create the
# in-project worktree .worktrees/<M> on branch <M>. Idempotent.
# Run from the root checkout on the branch PRs should target (it becomes BASE).
#
# Usage: scripts/milestone/claim <MILESTONE-ID>      e.g. 0A, 1B, 2A
# Prints: WORKTREE=<path> BRANCH=<M> BASE=<branch> SLUG=<plan slug> SESSION=drv-<M>
set -euo pipefail
. "$(cd "$(dirname "$0")" && pwd)/lib.sh"
[ $# -eq 1 ] || { echo "usage: claim <MILESTONE-ID>" >&2; exit 2; }
m=$1; session="drv-$m"
root=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
cd "$root"
base=$(git rev-parse --abbrev-ref HEAD)
wt="$root/.worktrees/$m"

row=$(ms_status_row "$m" docs/STATUS.md)
[ -n "$row" ] || { echo "no STATUS row for $m; the owner adds the row first (CLAUDE.md §0)" >&2; exit 3; }
owner=$(ms_status_owner "$m" docs/STATUS.md)
slug=$(ms_status_slug "$m" docs/STATUS.md)
case "$owner" in
  unclaimed|"")
    git diff --cached --quiet || { echo "index has staged changes; commit or unstage first" >&2; exit 4; }
    [ -z "$(git status --porcelain --untracked-files=no docs/STATUS.md)" ] || { echo "docs/STATUS.md has uncommitted changes" >&2; exit 4; }
    awk -v m="$m" -v s="$session" -F'|' 'BEGIN{OFS="|"} $0 ~ "^\\| \\**"m"[^|]*\\|" && $3 ~ /^ *unclaimed *$/ {$3=" "s" "} {print}' docs/STATUS.md > docs/STATUS.md.tmp
    mv docs/STATUS.md.tmp docs/STATUS.md
    git add docs/STATUS.md
    git commit -q -m "[docs] claim STATUS row $m for $session" -m "Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>"
    ;;
  "$session") ;;
  *) echo "STATUS row $m is claimed by '$owner'; pick another milestone or stop (CLAUDE.md §0)" >&2; exit 5 ;;
esac

if [ ! -d "$wt" ]; then
  if git show-ref --verify --quiet "refs/heads/$m"; then
    git worktree add "$wt" "$m" >/dev/null
  else
    git worktree add -b "$m" "$wt" "$base" >/dev/null
  fi
fi
"$root/scripts/milestone/driver-state" "$m" set worktree "$wt" branch "$m" base_branch "$base" slug "$slug" driver "$session" step claimed >/dev/null
echo "WORKTREE=$wt BRANCH=$m BASE=$base SLUG=$slug SESSION=$session"
