#!/usr/bin/env bash
# Everything the driver reads between worker sessions, in one call, but terse:
# the driver sees a VERDICT block, the handoff verbatim, and the lines it acts
# on; the full dump (ledger, plan ## Status, git, exit-check table, scope diff,
# commit checks) goes to docs/sdd/<M>/status-<N>.txt (gitignored) and is read
# only when a verdict line says so. This keeps the driver's per-gate context
# cost small and constant (driving-a-milestone, issue: driver context growth).
#
# Lines the driver acts on (SKILL.md step 5): `OUT-OF-SCOPE: <path>`,
# `COMMIT-CHECK: <commit> <problem>`, `SESSION-MISMATCH: ...`, `HISTORY: ...`,
# the exit-check `summary:` / `lock:` lines and any AT-RISK / DISAGREE /
# OWNER-CLAIM / MISSING / UNMATCHED / TAMPERED row, `WARN:` lines.
#
# Usage: scripts/milestone/status <MILESTONE-ID> [--full]     STATUS_NO_CHECKS=1 skips exit-check
#   --full  print the whole dump instead of the verdict (what this script printed before)
set -euo pipefail
[ $# -ge 1 ] || { echo "usage: status <MILESTONE-ID> [--full]" >&2; exit 2; }
m=$1; shift; full=0
for a in "$@"; do case "$a" in --full) full=1 ;; *) echo "unknown flag $a" >&2; exit 2 ;; esac; done
here=$(cd "$(dirname "$0")" && pwd); ds="$here/driver-state"
root=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
wt="$(dirname "$root")/$(basename "$root")-$m"
[ -d "$wt" ] || { echo "no worktree at $wt" >&2; exit 3; }
cd "$wt"
sec() { printf '\n===== %s\n' "$1"; }
slug=$(grep -E "^\| \*{0,2}${m}[ *|]" docs/STATUS.md | sed -n 's|.*docs/plans/\([A-Za-z0-9._-]*\)\.md.*|\1|p'); [ -n "$slug" ] || slug=$m
ledger=""; for l in "docs/sdd/$slug/progress.md" "docs/sdd/$m/progress.md"; do [ -f "$l" ] && { ledger=$l; break; }; done
handoff="docs/sdd/$m/handoff.md"

dump() {
sec "handoff  $handoff"
cat "$handoff" 2>/dev/null || echo "(none: this session wrote no handoff)"
if [ -f .claude/scope.json ] && [ -f "$handoff" ]; then
  want=$(jq -r '.session // empty' .claude/scope.json)
  got=$(sed -n 's/^session:[[:space:]]*//p' "$handoff" | head -1)
  [ -z "$want" ] || [ "$want" = "$got" ] || echo "SESSION-MISMATCH: handoff says session '$got', spawn recorded $want; treat the handoff as missing"
fi
# The SDD workspace script writes docs/sdd/<SLUG>/ (plan stem); the milestone
# scratch (handoff, briefs, lock) is docs/sdd/<M>/. Read the ledger from either.
sec "ledger   ${ledger:-docs/sdd/$slug/progress.md}"
[ -n "$ledger" ] && cat "$ledger" || echo "(none yet)"
sec "plan files"
found=0
for f in docs/plans/"$m"*.md; do
  [ -f "$f" ] || continue
  found=1; echo "$f"
  case "$f" in *.spec.md|*.impl.md) ;; *) awk '/^## Status/{p=1} p' "$f";; esac
done
[ "$found" = 1 ] || echo "(no plan files yet)"
sec "STATUS row"
grep -E "^\| \*{0,2}${m}[ *|]" docs/STATUS.md || echo "(no row)"
sec "git  $wt"
git status --short | awk 'NR<=20'
git log --oneline -5

sec "exit checks  (scripts/milestone/exit-check $m --fast; full run before and after finish)"
if [ "${STATUS_NO_CHECKS:-}" = 1 ]; then echo "(skipped: STATUS_NO_CHECKS=1)"; else "$here/exit-check" "$m" --fast; fi

sec "scope  .claude/scope.json (written by spawn)"
if [ ! -f .claude/scope.json ]; then
  echo "(none: spawn has not run in this worktree; no scope check possible)"
  return 0
fi
jq -r '"role=\(.role) session=\(.session) base=\(.base[0:12]) tasks=\(.tasks | map(.n) | join(","))", "allow: \(.allow | join(" "))", (.warnings[]? | "WARN: " + .)' .claude/scope.json
base=$(jq -r .base .claude/scope.json)
hook="$wt/scripts/hooks/guard-scope.sh"; [ -x "$hook" ] || hook="$root/scripts/hooks/guard-scope.sh"

sec "session diff  $(git rev-parse --short "$base")..HEAD"
if ! git merge-base --is-ancestor "$base" HEAD; then
  echo "HISTORY: HEAD $(git rev-parse --short HEAD) does not descend from base $(git rev-parse --short "$base"); the branch was rewritten or switched"
fi
echo "commits (subject / first body line):"
for c in $(git rev-list --reverse "$base..HEAD"); do
  printf '%s %s\n    body: %s\n' "$(git rev-parse --short "$c")" "$(git log -1 --format=%s "$c")" "$(git log -1 --format=%b "$c" | awk 'NF{print; exit}')"
done
[ -n "$(git rev-list "$base..HEAD")" ] || echo "(no commits since base)"
echo "files (committed + uncommitted):"
git diff --stat "$base" | tail -50
echo "uncommitted (tracked and untracked):"
git status --porcelain --untracked-files=all | awk 'NR<=40' ; [ -n "$(git status --porcelain --untracked-files=all)" ] || echo "(clean)"

sec "scope check"
changed=$( { git diff --name-only "$base"; git status --porcelain --untracked-files=all | cut -c4- | sed 's/.* -> //'; } | awk 'NF && !seen[$0]++')
bad=0
if [ -n "$changed" ]; then
  while IFS= read -r p; do
    r=$(CLAUDE_PROJECT_DIR="$wt" "$hook" --classify "$p" | cut -d' ' -f1)
    [ "$r" = ok ] || { echo "OUT-OF-SCOPE: $p"; bad=1; }
  done <<< "$changed"
fi
[ "$bad" = 1 ] || echo "paths: all $(printf '%s\n' "$changed" | awk 'NF' | wc -l | tr -d ' ') changed paths inside the scope"
# Commit convention: every commit since base carries a `[component] task N` body
# line (or `[docs]` for the session-end writes), names a task the scope contains,
# and touches the exact Files of at most one task.
task_of() { # $1 = path → task numbers whose exact Files list contains it
  jq -r --arg p "$1" '.tasks[] | select(.files | index($p)) | .n' .claude/scope.json | tr '\n' ' '
}
scope_tasks=$(jq -r '.tasks | map(.n) | join(" ")' .claude/scope.json)
for c in $(git rev-list --reverse "$base..HEAD"); do
  short=$(git rev-parse --short "$c")
  body1=$(git log -1 --format='%b' "$c" | awk 'NF{print; exit}')
  if ! printf '%s' "$body1" | grep -Eq '^\[[a-z0-9-]+\]'; then
    echo "COMMIT-CHECK: $short body first line is not '[component] task N: …' (got: ${body1:-<empty>})"
  fi
  tn=$(printf '%s' "$body1" | grep -oE 'task [0-9]+(\.[0-9]+)?' | grep -oE '[0-9]+(\.[0-9]+)?' | head -1 || true)
  if [ -n "$tn" ] && [ -n "$scope_tasks" ]; then
    case " $scope_tasks " in *" $tn "*) ;; *) echo "COMMIT-CHECK: $short names task $tn, not one of this session's tasks ($scope_tasks)";; esac
  fi
  spans=$(git diff-tree --no-commit-id -r --name-only "$c" | while IFS= read -r f; do task_of "$f"; done | tr ' ' '\n' | awk 'NF && !seen[$0]++' | tr '\n' ' ')
  span_n=$(printf '%s' "$spans" | wc -w | tr -d ' ')
  [ "$span_n" -le 1 ] || echo "COMMIT-CHECK: $short touches files of tasks $spans (one task per commit)"
  if [ -n "$tn" ] && [ "$span_n" = 1 ] && [ "${spans% }" != "$tn" ]; then
    echo "COMMIT-CHECK: $short says task $tn but changes files listed for task ${spans% }"
  fi
done
}

if [ "$full" = 1 ]; then dump; exit 0; fi

# ---- terse mode: dump to file, print verdict + handoff + actionable lines --------
n=$("$ds" "$m" get session 2>/dev/null || true); role=$("$ds" "$m" get role 2>/dev/null || true)
[ -n "$n" ] || n=$(jq -r '.session // "x"' .claude/scope.json 2>/dev/null || echo x)
[ -n "$role" ] || role=$(jq -r '.role // "?"' .claude/scope.json 2>/dev/null || echo "?")
out="docs/sdd/$m/status-$n.txt"; mkdir -p "docs/sdd/$m"
dump > "$out" 2>&1 || true

outcome=$(sed -n 's/^outcome:[[:space:]]*//p' "$handoff" 2>/dev/null | head -1 | tr -d '[:space:]')
if [ ! -f "$handoff" ]; then hand="missing"
elif grep -q '^SESSION-MISMATCH:' "$out"; then hand="mismatch"; outcome=""
elif [ -z "$outcome" ]; then hand="malformed (no outcome line)"
else hand="ok"; fi
cnt() { grep -c "$1" "$out" || true; }
oos=$(cnt '^OUT-OF-SCOPE:'); cc=$(cnt '^COMMIT-CHECK:'); hist=$(cnt '^HISTORY:'); warn=$(cnt '^WARN: ')
scope_v="clean"; [ "$oos" = 0 ] || scope_v="$oos OUT-OF-SCOPE"
commits_v="ok"; [ "$cc" = 0 ] || commits_v="$cc COMMIT-CHECK"
hist_v="ok"; [ "$hist" = 0 ] || hist_v="rewritten"
summary=$(grep -m1 -E '^summary: [0-9]+ PASS' "$out" | sed 's/^summary: *//' || true)
[ -n "$summary" ] || summary=$(grep -m1 -E '^exit-checks: none|^\(skipped' "$out" || echo "(no exit-check summary; see file)")
lock=$(grep -m1 -E '^lock: (OK|NONE|FROZEN|TAMPERED|EXISTS)' "$out" | sed 's/^lock: *//' || true); [ -n "$lock" ] || lock="none"
attention=$(grep -E '^(E|I)[0-9]+ .*→ (AT-RISK|DISAGREE|OWNER-CLAIM|MISSING|UNMATCHED)|^UNMATCHED |^lock: TAMPERED|^OUT-OF-SCOPE:|^COMMIT-CHECK:|^HISTORY:|^WARN: |^SESSION-MISMATCH:|^   \| ' "$out" || true)

# Role artifacts (facts only; the outcome table in SKILL.md says what DONE needs).
art=""
has() { [ -e "$1" ] && echo yes || echo no; }
case "$role" in
  plan)
    plan_has_checks=no; [ -f "docs/plans/$slug.md" ] && grep -q '^## Exit checks' "docs/plans/$slug.md" && plan_has_checks=yes
    art="spec=$(has docs/plans/$slug.spec.md) impl=$(has docs/plans/$slug.impl.md) plan=$(has docs/plans/$slug.md) exit-checks-table=$plan_has_checks ledger=$([ -n "$ledger" ] && echo yes || echo no)" ;;
  execute|probe)
    unfinished="?"
    if [ -n "$ledger" ]; then
      total=$(awk -F'|' '/^[[:space:]]*\|[[:space:]]*[0-9]+[[:space:]]*\|/{c++} END{print c+0}' "$ledger")
      done_n=$(awk -F'|' '/^[[:space:]]*\|[[:space:]]*[0-9]+[[:space:]]*\|/ { s=$5; if (s ~ /done|complete/) c++ } END{print c+0}' "$ledger")
      unfinished=$((total - done_n))
    fi
    rows=$(grep -cE '^(E|I)[0-9]+ ' "$out" || true); ep=$(awk '/^exit-progress:/{p=1; next} /^[a-z-]+:/{p=0} p && /^- /' "$handoff" 2>/dev/null | wc -l | tr -d ' ')
    atrisk=$(grep -ci 'at risk' "$handoff" 2>/dev/null || true); notyet=$(grep -ci 'not yet' "$handoff" 2>/dev/null || true)
    art="unfinished-tasks=$unfinished exit-progress-lines=$ep/$rows at-risk=$atrisk not-yet=$notyet" ;;
  finish)
    pr=$(grep -oE 'https://github\.com/[^ ]+/pull/[0-9]+' "$handoff" 2>/dev/null | head -1 || true)
    art="pr-url=${pr:-none} evidence-lines=$(awk '/^evidence:/{p=1; next} /^[a-z-]+:/{p=0} p && /^- /' "$handoff" 2>/dev/null | wc -l | tr -d ' ')" ;;
  audit) art="handoff-only role; compare exit-progress with the previous worker handoff (docs/sdd/$m/session-*-handoff.md)" ;;
esac

[ "$hand" = ok ] && "$ds" "$m" set last_outcome "${outcome:-null}" step gate >/dev/null 2>&1 || true

echo "===== VERDICT $m  session=$n role=$role  ($(git rev-parse --short HEAD), $(git status --porcelain --untracked-files=no | wc -l | tr -d ' ') uncommitted)"
echo "HANDOFF=$hand"
echo "OUTCOME=${outcome:-none}"
echo "SCOPE=$scope_v  COMMITS=$commits_v  HISTORY=$hist_v  WARN=$warn"
echo "EXIT=$summary"
echo "LOCK=$lock"
echo "ARTIFACTS: $art"
echo "FULL=$out   (read only when a line above is not clean/ok/none, or ARTIFACTS falls short of the role's DONE rule)"
sec "handoff  $handoff"
cat "$handoff" 2>/dev/null || echo "(none: this session wrote no handoff)"
if [ -n "$attention" ]; then
  sec "attention  (each line is a driver rule in SKILL.md; relay verbatim)"
  printf '%s\n' "$attention"
fi
