#!/usr/bin/env bash
# Install (or refresh) the milestone kit into a project: copies the scripts and
# hooks, links the skills, seeds the docs and templates that do not exist yet,
# appends the .gitignore block, and stamps .milestone-kit with the kit location
# so scripts/bootstrap/check can report drift.
#
# Idempotent. Never overwrites: scripts/milestone/config, .claude/settings.json
# (a MANUAL: line is printed when it lacks the hooks), .claude/settings.local.json,
# or any doc that already exists. Scripts and hooks ARE refreshed (they are the
# kit's, not the project's; `check` shows DRIFT when they differ).
#
# Usage: scripts/bootstrap/install <project-root> [--no-skills] [--no-templates] [--agent claude|codex]
#   --agent   which CLI the worker sessions run (MS_AGENT in scripts/milestone/config).
#             Default: the value already in the project's config, else claude. codex adds
#             .codex/hooks.json, AGENTS.md and a second set of skill links under .agents/skills
#             (Codex never reads .claude/skills), and links cx-session as the session skill.
# Prints one line per action: COPIED: / KEPT: / LINKED: / SEEDED: / MANUAL: / CONFIG:
set -euo pipefail
[ $# -ge 1 ] || { echo "usage: install <project-root> [--no-skills] [--no-templates] [--agent claude|codex]" >&2; exit 2; }
proj=$1; shift; skills=1; templates=1; agent=""
while [ $# -gt 0 ]; do
  case "$1" in
    --no-skills) skills=0; shift ;;
    --no-templates) templates=0; shift ;;
    --agent) agent=${2:-}; shift 2 ;;
    --agent=*) agent=${1#*=}; shift ;;
    *) echo "unknown flag $1" >&2; exit 2 ;;
  esac
done
[ -d "$proj" ] || { echo "no such directory: $proj" >&2; exit 3; }
proj=$(cd "$proj" && pwd)
kit=$(cd "$(dirname "$0")/../.." && pwd)                 # <general-cc-kit>/milestone-kit
gck=$(cd "$kit/.." && pwd)                                 # general-cc-kit (the kit sits at its root)
git -C "$proj" rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "MANUAL: $proj is not a git repository; run git init first" ; exit 4; }

copy_tree() { # $1 = kit subdir, $2 = project subdir, $3... = basenames never overwritten
  local src="$kit/$1" dst="$proj/$2" f rel keep
  mkdir -p "$dst"
  while IFS= read -r -d '' f; do
    rel=${f#"$src/"}
    keep=0; for k in "${@:3}"; do [ "$rel" = "$k" ] && keep=1; done
    if [ $keep = 1 ] && [ -e "$dst/$rel" ]; then echo "KEPT: $2/$rel"; continue; fi
    mkdir -p "$(dirname "$dst/$rel")"
    if [ -e "$dst/$rel" ] && cmp -s "$f" "$dst/$rel"; then continue; fi
    cp "$f" "$dst/$rel"; chmod +x "$dst/$rel" 2>/dev/null || true; echo "COPIED: $2/$rel"
  done < <(find "$src" -type f -print0)
}
copy_tree scripts/milestone scripts/milestone config
copy_tree scripts/hooks scripts/hooks
copy_tree scripts/sdd scripts/sdd
copy_tree scripts/bootstrap scripts/bootstrap
[ -f "$proj/scripts/milestone/config" ] || { cp "$kit/templates/milestone.config" "$proj/scripts/milestone/config"; echo "SEEDED: scripts/milestone/config (fill the {{…}} placeholders)"; }

# Agent: flag > existing MS_AGENT in config > claude. Recorded in config so check, spawn and the skills agree.
cfg="$proj/scripts/milestone/config"
[ -n "$agent" ] || agent=$(sed -n 's/^MS_AGENT=//p' "$cfg" | tr -d "\"'" | head -1)
agent=${agent:-claude}
case "$agent" in claude|codex) ;; *) echo "unknown --agent $agent (claude|codex)" >&2; exit 2 ;; esac
if grep -q '^MS_AGENT=' "$cfg"; then
  [ "$(sed -n 's/^MS_AGENT=//p' "$cfg" | head -1)" = "$agent" ] || { awk -v a="$agent" '/^MS_AGENT=/{print "MS_AGENT=" a; next}1' "$cfg" > "$cfg.tmp" && mv "$cfg.tmp" "$cfg"; echo "CONFIG: MS_AGENT=$agent"; }
else printf '# CLI the worker sessions run: claude | codex\nMS_AGENT=%s\n' "$agent" >> "$cfg"; echo "CONFIG: MS_AGENT=$agent"; fi
session_skill=cc-session; [ "$agent" = codex ] && session_skill=cx-session

# Hooks file for the agent: seed, or tell the owner what to merge. .claude/ exists for
# every agent (scope.json, the rule files, the skill links the scripts resolve).
mkdir -p "$proj/.claude/rules" "$proj/.claude/skills"
if [ "$agent" = codex ]; then hooks=.codex/hooks.json; hooks_tpl="$kit/templates/codex/hooks.json"; else hooks=.claude/settings.json; hooks_tpl="$kit/templates/claude/settings.json"; fi
mkdir -p "$proj/$(dirname "$hooks")"
if [ ! -f "$proj/$hooks" ]; then
  cp "$hooks_tpl" "$proj/$hooks"; echo "SEEDED: $hooks (hooks)"
  [ "$agent" = codex ] && echo "MANUAL: Codex loads $hooks only after the owner trusts the project (and each new worktree path) in the pane; review with /hooks"
else
  for h in guard-scope.sh require-handoff.sh guard-superpowers-paths.sh; do
    grep -q "$h" "$proj/$hooks" || echo "MANUAL: $hooks lacks the $h hook; merge $hooks_tpl by hand"
  done
fi
if [ "$agent" = claude ]; then
  [ -f "$proj/.claude/settings.local.json" ] || [ -f "$proj/.claude/settings.local.json.example" ] || { cp "$kit/templates/claude/settings.local.json.example" "$proj/.claude/settings.local.json.example"; echo "SEEDED: .claude/settings.local.json.example (owner copies to settings.local.json and edits the allowlist)"; }
fi

# .gitignore block: appended once; between its two markers it is the kit's, so a
# newer template replaces it in place (the owner's own lines outside it are kept).
if ! grep -q '^# ---- milestone-kit' "$proj/.gitignore" 2>/dev/null; then
  { [ -f "$proj/.gitignore" ] && [ -n "$(tail -c1 "$proj/.gitignore")" ] && echo; cat "$kit/templates/gitignore.block"; } >> "$proj/.gitignore"
  echo "COPIED: .gitignore (milestone-kit block appended)"
elif ! diff -q <(awk '/^# ---- milestone-kit/{p=1} p{print} /^# ---- end milestone-kit/{p=0}' "$proj/.gitignore") "$kit/templates/gitignore.block" >/dev/null 2>&1; then
  awk -v tpl="$kit/templates/gitignore.block" '
    /^# ---- milestone-kit/ && !done { while ((getline l < tpl) > 0) print l; skip=1; done=1; next }
    skip && /^# ---- end milestone-kit/ { skip=0; next }
    !skip { print }' "$proj/.gitignore" > "$proj/.gitignore.tmp" && mv "$proj/.gitignore.tmp" "$proj/.gitignore"
  echo "COPIED: .gitignore (milestone-kit block refreshed)"
fi

# skills: always into .claude/skills (the scripts resolve briefs.md and the session script
# there); with --agent codex also into .agents/skills, the only place Codex looks.
if [ $skills = 1 ]; then
  link() { # $1 = dest subdir, $2 = name, $3 = target
    local t="$proj/$1/$2"
    [ -e "$3/SKILL.md" ] || { echo "MANUAL: skill source missing: $3"; return; }
    if [ -L "$t" ] && [ "$(readlink "$t")" = "$3" ]; then return; fi
    [ -e "$t" ] && [ ! -L "$t" ] && { echo "MANUAL: $1/$2 is a real directory; move it aside to link the kit's"; return; }
    ln -sfn "$3" "$t"; echo "LINKED: $1/$2 -> $3"
  }
  dests=.claude/skills; [ "$agent" = codex ] && dests=".claude/skills .agents/skills"
  for d in $dests; do
    mkdir -p "$proj/$d"
    link "$d" driving-a-milestone "$kit/skills/driving-a-milestone"
    link "$d" bootstrapping-milestones "$kit/skills/bootstrapping-milestones"
    link "$d" adding-a-milestone "$kit/skills/adding-a-milestone"
    link "$d" cris-managed-session "$gck/skills/$session_skill"
    if [ -x "$gck/link-superpowers-skills.sh" ]; then
      "$gck/link-superpowers-skills.sh" "$proj" --prefix obra --dest-subdir "$d" | sed "s|^linked |LINKED: $d/|" | grep -v '^$' || true
    else
      echo "MANUAL: $gck/link-superpowers-skills.sh not found; link the superpowers skills as $d/obra-<name>"
    fi
  done
fi

# docs and templates (never overwrite)
if [ $templates = 1 ]; then
  seed() { # $1 = template rel path, $2 = project rel path
    [ -e "$proj/$2" ] && return 0
    mkdir -p "$(dirname "$proj/$2")"; cp "$kit/templates/$1" "$proj/$2"; echo "SEEDED: $2"
  }
  seed CLAUDE.md CLAUDE.md
  [ "$agent" = codex ] && seed AGENTS.md AGENTS.md
  seed docs/STATUS.md docs/STATUS.md
  seed docs/05-roadmap.md docs/05-roadmap.md
  seed docs/plans/README.md docs/plans/README.md
  seed docs/sdd/README.md docs/sdd/README.md
  seed docs/adr/README.md docs/adr/README.md
  seed docs/adr/0000-template.md docs/adr/0000-template.md
  seed docs/journal/README.md docs/journal/README.md
  mkdir -p "$proj/docs/tickets"
  [ -e "$proj/docs/tickets/.gitkeep" ] || { : > "$proj/docs/tickets/.gitkeep"; echo "SEEDED: docs/tickets/.gitkeep"; }
  [ -d "$proj/.claude/rules" ] && [ -z "$(ls -A "$proj/.claude/rules")" ] && { cp "$kit/templates/rules/component.md" "$proj/.claude/rules/_component.template.md"; echo "SEEDED: .claude/rules/_component.template.md (copy per component, then delete)"; }
fi

printf 'kit=%s\nsha=%s\ninstalled=%s\nagent=%s\n' "$kit" "$(git -C "$gck" rev-parse --short HEAD 2>/dev/null || echo unknown)" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$agent" > "$proj/.milestone-kit"
echo "STAMP: .milestone-kit -> $kit (agent=$agent)"
echo "next: scripts/bootstrap/check (from $proj)"
