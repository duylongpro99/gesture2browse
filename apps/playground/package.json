{
  "name": "@gesture/playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "probe:latency": "node src/latency-probe-cli.ts",
    "test:bench": "playwright test -c playwright.config.ts",
    "bench:sweep": "playwright test -c playwright.bench-sweep.config.ts",
    "lint": "biome lint ./src ./test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@gesture/gesture-core": "workspace:*",
    "@gesture/protocol": "workspace:*",
    "@mediapipe/tasks-vision": "1.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
